# Cấu hình GĐ1 — sao chép thành .env (bash scripts/task.sh setup tự làm nếu chưa có).
# Đường dẫn tương đối tính từ gốc repo. Backend đọc qua pydantic-settings, Vite đọc API_PORT/WEB_PORT.
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
API_PORT=8000
WEB_PORT=5173
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# --- GĐ2: Docker Compose (compose.yaml đọc các biến này; DATABASE_URL ở trên chỉ dùng cho chạy native) ---
# POSTGRES_PASSWORD=đặt-mật-khẩu-dài          # BẮT BUỘC khi dùng docker compose
# SECRET_KEY=<≥ 32 ký tự ngẫu nhiên>            # BẮT BUỘC khi dùng docker compose (ký phiên đăng nhập); native: tự tạo data/secret_key
# COOKIE_SECURE=false                         # true khi web chạy sau HTTPS
# POSTGRES_USER=gpu
# POSTGRES_DB=gpu_util
# HTTP_BIND=127.0.0.1                         # chỉ mở 0.0.0.0 khi đã có HTTPS phía trước (DEPLOY_VM §4)
# HTTP_PORT=8080
# BACKUP_AT=02:00
# BACKUP_KEEP=30
# GD1_DATA=./data                             # thư mục app.db + uploads/ của GĐ1 cho `docker compose run --rm replay`
# TRUSTED_PROXIES=10.0.0.5                     # proxy hạ tầng đứng trước web (IP/CIDR, cách nhau bởi dấu cách/phẩy) → đúng IP người dùng

# --- HTTPS trên server (compose.tls.yaml, DEPLOY.md §8) — kiểm chứng chỉ: bash scripts/task.sh tls-check <cert> <key> [tên-miền] ---
# COMPOSE_FILE=compose.yaml:compose.tls.yaml  # Linux/VM; Windows dùng ';' — mọi lệnh docker compose tự áp HTTPS
# TLS_CERT_FILE=/etc/gpu-util/tls/fullchain.pem   # chứng chỉ + chuỗi trung gian (để NGOÀI thư mục repo)
# TLS_KEY_FILE=/etc/gpu-util/tls/privkey.pem      # khóa riêng, không passphrase, quyền 600
# HTTPS_BIND=0.0.0.0                          # mặc định 127.0.0.1; 0.0.0.0 hoặc IP nội bộ của VM để mở cho đầu mối
# HTTPS_PORT=443
# (compose.tls.yaml tự đặt COOKIE_SECURE=true cho api)
# PG_PORT=15432                               # compose.dev.yaml: cổng PG mở ra 127.0.0.1

# --- Test trên PostgreSQL (bash scripts/task.sh test-pg) ---
# TEST_PG_URL=postgresql+psycopg://gpu_test@127.0.0.1:55432/postgres   # = bash scripts/task.sh pg-temp start
